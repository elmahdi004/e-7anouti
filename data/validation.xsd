<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  


  <!-- Définition de l'élément <Store> -->
  <xs:element name="Store">
    <xs:complexType>
      <xs:sequence>
        <!-- Languages Section -->
        <xs:element name="languages">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="lang" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:attribute name="code" type="xs:string" />
                    <xs:attribute name="title" type="xs:string" />
                    <xs:element name="content" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:attribute name="key" type="xs:string" />
                          <xs:value />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Categories Section -->
        <xs:element name="categories">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="category" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="name">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="lang" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:attribute name="code" type="xs:string" />
                                <xs:value />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="image" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Products Section -->
        <xs:element name="products">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="product" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="name">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="lang" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:attribute name="code" type="xs:string"/>
                                <xs:value/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="description">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="lang" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:attribute name="code" type="xs:string"/>
                                <xs:value/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="price" type="currency"/>
                    <xs:element name="pre_price" type="currency"/>
                    <xs:element name="stock" type="xs:int"/>
                    <xs:element name="image" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Users Section -->
        <xs:element name="users">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="user" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:attribute name="id" type="xs:int"/>
                    <xs:attribute name="role" type="xs:int"/>
                    <xs:element name="firstName" type="xs:string"/>
                    <xs:element name="lastName" type="xs:string"/>
                    <xs:element name="email" type="xs:string"/>
                    <xs:element name="password" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Permissions Section -->
        <xs:element name="permissions">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="permission" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:attribute name="id" type="xs:int"/>
                    <xs:value/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Roles Section -->
        <xs:element name="roles">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="role" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:attribute name="id" type="xs:int"/>
                    <xs:element name="name" type="xs:string"/>
                    <xs:element name="permission-id" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:attribute name="id" type="xs:int"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Carts Section -->
        <xs:element name="Carts">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Cart" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:attribute name="user" type="xs:int"/>
                    <xs:element name="item" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:attribute name="product" type="xs:int"/>
                          <xs:element name="quantity" type="xs:int"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Définition des types simples -->
  <xs:simpleType name="currency">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z]{3}"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
